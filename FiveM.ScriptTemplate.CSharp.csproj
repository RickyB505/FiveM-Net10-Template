<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeContentInPack>true</IncludeContentInPack>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <PackageOutputPath>./nupkg</PackageOutputPath>

    <PackageType>Template</PackageType>
    <PackageId>Ricky.FiveM.ScriptTemplate.CSharp</PackageId>
    <!-- Overridden at pack time by the GitHub Actions workflow; local packs default to 1.0.0 -->
    <PackageVersion Condition="'$(PackageVersion)' == ''">1.0.0</PackageVersion>
    <Title>FiveM C# Client/Server Script Template</Title>
    <Authors>YOUR_NAME_HERE</Authors>
    <Description>A dotnet new template that scaffolds a FiveM/RedM CitizenFX C# client/server script resource (solution, client project, server project, fxmanifest.lua).</Description>
    <PackageTags>templates;fivem;citizenfx;gta5</PackageTags>
    <PackageProjectUrl>https://github.com/RickyB505/FiveM-Net10-Template</PackageProjectUrl>
    <RepositoryUrl>https://github.com/RickyB505/FiveM-Net10-Template</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="content\**\*" Exclude="content\**\bin\**;content\**\obj\**;content\**\.vs\**" />
    <Compile Remove="**\*.cs" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
